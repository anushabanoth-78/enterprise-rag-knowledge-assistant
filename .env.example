# ---- copy to .env and fill in. Never commit .env.
# set to "production" to refuse unsafe config at startup
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
# comma-separated; list only your real frontend origin(s)
CORS_ORIGINS=http://localhost:3000
# these emails become admins when they register
ADMIN_EMAILS=you@example.com

# ---- file storage: "local" (docker compose volume) or "s3" (Cloudflare R2 / AWS S3 / MinIO)
STORAGE_BACKEND=local
UPLOAD_DIR=/data/uploads
# R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ---- limits
MAX_UPLOAD_MB=50
MAX_PAGES_PER_DOCUMENT=500
MAX_DOCUMENTS_PER_USER=100
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
# true only behind a reverse proxy you control
TRUST_PROXY_HEADERS=false

# ---- retrieval
# Cross-encoder logit below which a passage counts as "not relevant". Tune on experiments/benchmark.jsonl.
MIN_RERANK_SCORE=-3.0

# ---- LLMs (any OpenAI-compatible chat completions API)
HOSTED_BASE_URL=https://api.openai.com/v1
HOSTED_API_KEY=
HOSTED_MODEL=gpt-4o-mini
# Local model via Ollama (docker compose --profile local up)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
